{
  // 以下为本项目参数，宇树未公布这些字段的官方配置范围。
  // 建议值与项目校验范围不代表机器人硬件极限；详见 deploy/OFFICIAL_LIMITS.md。
  // -------------------------------- 双臂速度与手柄映射 --------------------------------
  // 双臂正常跟随时的关节目标最大变化速度，单位 rad/s，两侧分别限速。
  // 建议 0.20～0.40；项目允许 0.05～1.0。
  "joint_speed_rad_s": 0.25,

  // 启动归位及左手柄 Y 键归位时的关节目标最大速度，单位 rad/s。
  // 建议 0.10～0.15； 项目允许 0.05～0.20。
  "home_speed_rad_s": 0.15,

  // 启用双臂时的 Python 主控制循环目标频率，单位 Hz，不是底层电机控制频率或相机保存帧率。
  // 建议 20～30；项目允许 10～60。
  // 同时影响该循环中的底盘等指令更新；仅底盘模式固定 20 Hz。
  // 实际频率受 PC2 计算与图像处理耗时影响。
  "control_hz": 20,

  // 手柄相对平移到机械臂末端目标平移的比例，无单位。
  // 建议 0.4～0.6；项目允许 0.1～1.0。
  // 例如 0.5 时手柄移动 10 cm 对应目标移动 5 cm； 不改变旋转比例，也不能突破速度限制。
  "position_scale": 0.6,


  // -------------------------------- 单次侧握的手柄活动范围 --------------------------------
  // 一次按住侧握键期间，手柄相对该次握键起点允许的最大直线位移，单位 m，不是累计路径或机械臂可达半径。
  // 建议 0.4～0.6；项目允许 0.1～0.8。
  // 超出会触发停止，需松开握键、摇杆回中并按 A 重新启用；扩大此值不能解决 IK 不可达。
  "clutch_translation_m": 0.4,

  // 一次侧握期间，手柄相对起始朝向允许的最大旋转角，单位 rad。
  // 建议 0.8～1.2（约 46°～69°）；项目允许 0.2～2.0。
  // 超出后的处理同 clutch_translation_m；此参数不是转腕速度。
  "clutch_rotation_rad": 1.2,

  // -------------------------------- 末端目标限速与 IK 平滑 --------------------------------
  // IK 求解前，末端目标平移增量按此值乘控制周期限幅，单位 m/s，不是实际末端速度保证值。
  // 建议 0.20～0.40；项目允许 0.05～0.80。
  // 还受关节限速与可达性约束。
  "cartesian_speed_m_s": 0.4,

  // IK 求解前，末端目标姿态每周期旋转增量的速度上限，单位 rad/s。
  // 建议 0.8～2.0；项目允许 0.2～3.0。
  // 与单次侧握旋转范围不同。
  "rotation_speed_rad_s": 2.0,

  // IK 关节解的平滑权重，按最新到最旧排列。
  // 建议先保持 [0.4, 0.3, 0.2, 0.1]；
  // 需要减少拖尾时可比较 [0.6, 0.4]，但平滑效果会减弱。
  // 项目要求 1～8 项、每项为正数、总和为 1。
  "filter_weights": [0.4, 0.3, 0.2, 0.1]
}
