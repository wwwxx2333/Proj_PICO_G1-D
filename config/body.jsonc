{
  // -------------------------------- 摇杆与底盘 --------------------------------
  // 两个摇杆共用的死区，无单位；也用于按 A 启用和模式切换时的回中判断。
  // 建议 0.10～0.20；项目调参范围（官方无对应配置范围） 0 <= deadzone < 1。
  // 超出死区后按剩余行程重新缩放，打满仍对应设定速度上限。
  "deadzone": 0.15,

  // 左摇杆前后打满时的底盘前进/后退速度上限，单位 m/s。
  // 实验室起步建议 0.05～0.10；配置允许 0～1.5，0 表示禁用该轴输出。
  // 官方 Move 的 vx 为 -1.5～1.5 m/s；Python 与 C++ 均按此范围校验。
  // 启动时固定读取本文件；修改后重启，不接受命令行数值覆盖。
  "max_forward_mps": 0.30,

  // 左摇杆左右打满时的底盘转向角速度上限，单位 rad/s。
  // 实验室起步建议 0.05～0.15；配置允许 0～0.6，0 表示禁用该轴输出。
  // 官方 Move 的 vyaw 为 -0.6～0.6 rad/s；Python 与 C++ 均按此范围校验。
  // 此项只影响底盘转向，腰部左右转动使用下方 waist_yaw_speed_rad_s。
  "max_yaw_rps": 0.15,

  // -------------------------------- 立柱升降 --------------------------------
  // LIFT 模式下右摇杆上下打满时的归一化升降速度，不是 m/s。
  // 实验室起步建议 0.05～0.15；配置允许 0～1，0 表示禁用升降输出。
  // 官方 HeightAdjust 的 vz 为 -1～1；速度直接修改本项。
  // 官网称约 60 mm/s，SDK 注释称满量程 76.5 mm/s；不能当作一致的实测速度。
  "max_lift_normalized": 0.15,

  // 立柱 rt/hispeed_state.y 的反馈坐标下限，单位 m，不是整机高度。
  // 官网高度差支持总行程 0.42 m，但未据此确认反馈零点；本机沿用 0.0。
  // 反馈坐标需以实机标定为准，不要填整机最低高度 1.26。
  // 项目校验要求 0 <= min < max，窗口跨度 <= 0.42 m；不再采用任意的 3 m 上限。
  "height_min_m": 0.0,

  // 立柱反馈坐标上限，单位 m；建议保持 0.42 或在确认反馈后缩小窗口。
  // C++ 在两端各保留 min(0.01, 窗口宽度*0.2) m 的方向停止余量。
  // 当前 0～0.42 对应约 0.01～0.41 m 停止边界；无需重复扣除余量。
  // 上下限直接修改本文件；--without-lift 可在本次启动关闭升降。
  "height_max_m": 0.42,

  // -------------------------------- 上身左右转动 --------------------------------
  // 腰部左右转动相对机器人关节零位的对称角度上限，单位 rad；
  // 例如 0.5235987756 表示 ±30°。
  // 建议 0.1745～0.5236（约 ±10°～±30°）；
  // 官方 URDF 支持对称角度上限 0～2.7053（完整关节范围约 ±155°）。
  // 不是相对按 A 时的位置再偏转同样角度。
  "waist_yaw_limit_rad": 0.5235987756,

  // 右摇杆水平打满时的腰部转动目标速度上限，单位 rad/s。
  // 建议 0.05～0.10；项目调参范围（官方无对应配置范围） 0.02～0.20。
  // 双臂随躯干一起转动。
  "waist_yaw_speed_rad_s": 0.1,

  // 腰部转动目标速度的加减速度上限，单位 rad/s²。
  // 建议 0.10～0.20；项目调参范围（官方无对应配置范围） 0.05～0.50。
  // 越小启停越缓，松摇杆后到目标速度降为零的时间也越长。
  "waist_yaw_accel_rad_s2": 0.2,

  // -------------------------------- 上身前后俯仰 --------------------------------
  // 上身俯仰下限，单位 rad。
  // 建议保持 0.0（直立）；官方 URDF 范围 -0.04363～2.3562 rad（约 -2.5°～135°）。
  // 必须 min < max，两端都在官方范围内；不强制窗口包含零位。
  // 无需设为负数就能从前倾姿态返回直立，不建议为解决无法抬起而改成负值。
  "waist_pitch_min_rad": 0.0,

  // 上身前倾角度上限，单位 rad。
  // 建议 0.1745～0.5236（约 10°～30°）；必须 min < max <= 2.3562 rad。
  // 配置值是所选工作窗口；合法最大值按官方 URDF 机械范围校验。
  "waist_pitch_max_rad": 0.5235987756,

  // PITCH 模式下右摇杆上下打满时的俯仰目标速度上限，单位 rad/s。
  // 建议 0.04～0.08；项目调参范围（官方无对应配置范围） 0.01～0.15。
  // 左手柄 X 在 PITCH 与立柱 LIFT 模式间切换。
  "waist_pitch_speed_rad_s": 0.08,

  // 俯仰目标速度的加减速度上限，单位 rad/s²。
  // 建议 0.08～0.16；项目调参范围（官方无对应配置范围） 0.02～0.30。
  // 与俯仰速度共同决定启动和停止的平滑程度。
  "waist_pitch_accel_rad_s2": 0.16,

  // -------------------------------- 俯仰跟随保护 --------------------------------
  // 限制俯仰目标继续领先实际反馈的角度偏差，单位 rad，防止未执行目标不断积累。
  // 建议先保持 0.10；
  // 如需更严格可在 0.08～0.10 内评估。
  // 项目调参范围（官方无对应配置范围） 0.05～0.15；
  // 不建议靠放宽它解决机器人不跟随。
  "waist_pitch_max_error_rad": 0.1,

  // 俯仰接近跟随偏差上限、持续请求运动却没有足够同向进展时的判定时长，单位 s；
  // 不是 PICO 或 DDS 缺帧超时。
  // 建议先保持 1.5，较保守调整可在 1.0～1.5 内评估；
  // 项目调参范围（官方无对应配置范围） 0.5～5.0。
  // 触发后仅俯仰保持实测姿态，右摇杆回中再推动恢复。
  "waist_pitch_stall_timeout_s": 1.5,

  // 俯仰停滞判定中，实际角度沿请求方向至少变化多少才算有进展并重置计时，单位 rad。
  // 建议先保持 0.005；
  // 结合反馈噪声评估时可参考 0.003～0.005。
  // 项目调参范围（官方无对应配置范围） 0.001～0.020；
  // 过小可能把噪声当运动，过大可能把缓慢运动判为停滞。
  "waist_pitch_min_progress_rad": 0.005
}
