{
  // 采集者编号，不知道时保留 null；同一次启动共用。
  "collector_id": null,
  // 机器人资产编号，不要把型号当成唯一编号。
  "robot_id": null,
  // 任务类别编号，例如 navigate_pick_cup；具体指令仍由启动参数填写。
  "task_id": null,
  // 本次实验室布局编号；移动家具/操作台后请更换。
  "layout_id": null,
  // 本条路线/目标组合编号；同一次启动共用，也可在主机逐条标注。
  "route_id": null,
  // 地图版本编号；尚未建立可靠定位时保留 null。
  "map_id": null,
  // 起点区域名称，不代表已经获得精确坐标。
  "start_area": null,
  // 目标区域名称，不代表已经获得精确坐标。
  "goal_area": null,
  // 仅用于数据质量标记的反馈最大年龄（秒），不修改运动保护逻辑；允许 0.01～2。
  "max_state_age_s": 0.25,
  // 主机离线训练导出的采样频率；允许 1～60，不改变实时控制或相机源帧率。
  "export_fps": 20.0,
  // 离线匹配图片/状态/动作允许的最大时间差（秒）；允许 0.001～1。
  "export_max_gap_s": 0.10,
  // 动作监督时间相对观测时间的偏移（秒）；未标定前保持 0，不代表已补偿链路延迟。
  // 允许 0～1；只影响主机导出，须根据实际控制接口和延迟验证后调整。
  "export_action_offset_s": 0.0
}
