{
  // 运行日志目录；相对路径以本项目根目录为准，不受启动目录影响。
  // 与 episode 数据分开，默认保存到 PC2 的 logs/runtime/。
  "directory": "logs/runtime",

  // 最多保留多少份运行日志；允许 1～100，默认 100。
  // 新建时淘汰最旧的已关闭日志，不删除正在写入的日志或其他文件。
  "max_files": 100,

  // 文件缓冲刷新间隔，单位秒；允许 0.1～10，建议 1。
  // 正常退出还会刷新并同步日志；每行带采集端接收时间。
  "flush_interval_s": 1.0,

  // 等待 PICO、等待 A 等状态持续不变时的终端提醒间隔。
  // 单位秒；允许 1～300，建议 10；状态变化立即提示。
  "wait_repeat_s": 10.0,

  // 文件和终端各自的有界缓冲容量，单位为日志记录条数。
  // 允许 128～16384，建议 4096；满时明确报告丢失数量，不阻塞控制。
  "queue_capacity": 4096
}
