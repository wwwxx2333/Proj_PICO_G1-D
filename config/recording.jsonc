{
  // 以下为本项目参数，宇树未公布这些字段的官方配置范围。
  // 建议值与项目校验范围不代表机器人硬件极限；详见 deploy/OFFICIAL_LIMITS.md。
  // ---------------------------------------- PC2 本地缓存 ----------------------------------------
  // PC2 录制缓存目录。
  // 建议保持 .local/recording_spool；
  // 须为非空字符串；相对路径以项目根目录为基准，也支持绝对路径和 ~。
  // 主机长期保存目录由 fetch 命令的 --destination 指定。
  // 录制和拉取均读取此文件；整次控制会话结束并传走数据前不要更改目录。
  "spool": ".local/recording_spool",

  // 整个缓存目录的总配额，包含此前保留的任务，单位 GB（1 GB = 10^9 字节）。
  // 建议起步 20～50 GB；
  // 项目允许 0.01～10000 GB，仍受实际可用磁盘限制。
  // 运行中达到限额停止新增图片、状态和日志，控制继续；
  // 按 L3 开始时若缓存已满则拒绝创建本条录制，机器人控制继续。
  "max_cache_gb": 20.0,

  // PC2 所在文件系统需要预留的可用空间，单位 GB。
  // 建议 10～20 GB；
  // 当前实际配置为 2 GB。
  // 项目允许 0～10000 GB；
  // 低于阈值停止新增录制数据，但不自动清理文件。
  "min_free_gb": 2.0,

  // ---------------------------------------- 图像保存 ----------------------------------------
  // 每路相机保存 JPEG 的目标采样频率，单位 FPS。
  // 建议 10～20：10～15 减少写盘与文件数量，20 保留更多动作细节；
  // 项目允许 1～60。
  // 实际保存率受源帧率和处理负载影响，不保证达到设置值；
  // 此项不改变 PICO 预览、相机源帧率或控制频率。
  "image_fps": 20.0,

  // 保存哪些相机。
  // 导航与抓取任务建议保留 head、left_wrist、right_wrist 三路；
  // 仅导航可选择 ["head"]。
  // 项目允许这些名称组成的不重复列表；
  // [] 表示不保存图像，但仍可记录状态和日志。
  // head 为左右目拼接的一张 JPEG，左右腕各一张。
  "cameras": ["head", "left_wrist", "right_wrist"],

  // 连接 PC2 本机 TeleImager 获取相机配置的 TCP 端口，不是各路图像流端口或 PICO 网页端口。
  // 建议保持 60000，只有服务端同步修改后才调整。
  // 项目允许整数 1～65535。
  "camera_config_port": 60000
}
